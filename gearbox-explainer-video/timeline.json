{"scenes": [{"n": 1, "dur": 11.368, "lead": 0.4, "audio": "audio/line01.mp3", "offset": 0.4, "words": [{"t0": 0.1, "t1": 0.575, "w": "الموتور"}, {"t0": 0.575, "t1": 1.049, "w": "ده"}, {"t0": 1.049, "t1": 1.524, "w": "بيلف"}, {"t0": 1.524, "t1": 1.998, "w": "ألف"}, {"t0": 1.998, "t1": 2.473, "w": "وأربعمية"}, {"t0": 2.473, "t1": 2.947, "w": "لفة"}, {"t0": 2.947, "t1": 3.421, "w": "في"}, {"t0": 3.421, "t1": 3.896, "w": "الدقيقة."}, {"t0": 3.846, "t1": 4.311, "w": "السير"}, {"t0": 4.311, "t1": 4.777, "w": "اللي"}, {"t0": 4.777, "t1": 5.242, "w": "قدامك"}, {"t0": 5.242, "t1": 5.708, "w": "عايز"}, {"t0": 5.708, "t1": 6.173, "w": "خمسين"}, {"t0": 6.173, "t1": 6.639, "w": "لفة"}, {"t0": 6.639, "t1": 7.104, "w": "بس"}, {"t0": 7.104, "t1": 7.569, "w": "وقوة"}, {"t0": 7.569, "t1": 8.035, "w": "تشيل"}, {"t0": 8.035, "t1": 8.5, "w": "طن،"}, {"t0": 8.5, "t1": 8.966, "w": "فمين"}, {"t0": 8.966, "t1": 9.431, "w": "بيعمل"}, {"t0": 9.431, "t1": 9.897, "w": "الحوار"}, {"t0": 9.897, "t1": 10.362, "w": "ده؟"}], "text": "الموتور ده بيلف ألف وأربعمية لفة في الدقيقة. السير اللي قدامك عايز خمسين لفة بس وقوة تشيل طن، فمين بيعمل الحوار ده؟"}, {"n": 2, "dur": 10.432, "lead": 0.4, "audio": "audio/line02.mp3", "offset": 11.768, "words": [{"t0": 0.1, "t1": 0.568, "w": "افتكر"}, {"t0": 0.568, "t1": 1.036, "w": "عجلة"}, {"t0": 1.036, "t1": 1.504, "w": "السباق،"}, {"t0": 1.504, "t1": 1.972, "w": "لما"}, {"t0": 1.972, "t1": 2.441, "w": "تنقل"}, {"t0": 2.441, "t1": 2.909, "w": "على"}, {"t0": 2.909, "t1": 3.377, "w": "الترس"}, {"t0": 3.377, "t1": 3.845, "w": "الصغير"}, {"t0": 3.845, "t1": 4.313, "w": "قدام"}, {"t0": 4.313, "t1": 4.781, "w": "والكبير"}, {"t0": 4.781, "t1": 5.249, "w": "ورا"}, {"t0": 5.249, "t1": 5.717, "w": "بتطلع"}, {"t0": 5.717, "t1": 6.185, "w": "الطلعة"}, {"t0": 6.185, "t1": 6.653, "w": "براحة"}, {"t0": 6.653, "t1": 7.122, "w": "بس"}, {"t0": 7.122, "t1": 7.59, "w": "ببطء،"}, {"t0": 7.59, "t1": 8.058, "w": "ودي"}, {"t0": 8.058, "t1": 8.526, "w": "بالظبط"}, {"t0": 8.526, "t1": 8.994, "w": "فكرة"}, {"t0": 8.994, "t1": 9.462, "w": "الجيربوكس."}], "text": "افتكر عجلة السباق، لما تنقل على الترس الصغير قدام والكبير ورا بتطلع الطلعة براحة بس ببطء، ودي بالظبط فكرة الجيربوكس."}, {"n": 3, "dur": 9.904, "lead": 0.4, "audio": "audio/line03.mp3", "offset": 22.2, "words": [{"t0": 0.1, "t1": 0.542, "w": "جوه"}, {"t0": 0.542, "t1": 0.983, "w": "الجيربوكس"}, {"t0": 0.983, "t1": 1.425, "w": "ترس"}, {"t0": 1.425, "t1": 1.867, "w": "صغير"}, {"t0": 1.867, "t1": 2.308, "w": "بيدوّر"}, {"t0": 2.308, "t1": 2.75, "w": "واحد"}, {"t0": 2.75, "t1": 3.192, "w": "أكبر"}, {"t0": 3.192, "t1": 3.634, "w": "منه،"}, {"t0": 3.634, "t1": 4.075, "w": "لو"}, {"t0": 4.075, "t1": 4.517, "w": "الصغير"}, {"t0": 4.517, "t1": 4.959, "w": "عشرين"}, {"t0": 4.959, "t1": 5.4, "w": "سنة"}, {"t0": 5.4, "t1": 5.842, "w": "والكبير"}, {"t0": 5.842, "t1": 6.284, "w": "ستين"}, {"t0": 6.284, "t1": 6.725, "w": "فالكبير"}, {"t0": 6.725, "t1": 7.167, "w": "بيلف"}, {"t0": 7.167, "t1": 7.609, "w": "أبطأ"}, {"t0": 7.609, "t1": 8.051, "w": "بتلات"}, {"t0": 8.051, "t1": 8.492, "w": "مرات"}, {"t0": 8.492, "t1": 8.934, "w": "بالظبط."}], "text": "جوه الجيربوكس ترس صغير بيدوّر واحد أكبر منه، لو الصغير عشرين سنة والكبير ستين فالكبير بيلف أبطأ بتلات مرات بالظبط."}, {"n": 4, "dur": 9.88, "lead": 0.4, "audio": "audio/line04.mp3", "offset": 32.104, "words": [{"t0": 0.1, "t1": 0.52, "w": "وكل"}, {"t0": 0.52, "t1": 0.94, "w": "ما"}, {"t0": 0.94, "t1": 1.36, "w": "السرعة"}, {"t0": 1.36, "t1": 1.78, "w": "تقل"}, {"t0": 1.78, "t1": 2.2, "w": "القوة"}, {"t0": 2.2, "t1": 2.621, "w": "تزيد"}, {"t0": 2.621, "t1": 3.041, "w": "بنفس"}, {"t0": 3.041, "t1": 3.461, "w": "النسبة،"}, {"t0": 3.461, "t1": 3.881, "w": "قسمت"}, {"t0": 3.881, "t1": 4.301, "w": "السرعة"}, {"t0": 4.301, "t1": 4.721, "w": "على"}, {"t0": 4.721, "t1": 5.141, "w": "تلاتة"}, {"t0": 5.141, "t1": 5.561, "w": "يبقى"}, {"t0": 5.561, "t1": 5.981, "w": "ضربت"}, {"t0": 5.981, "t1": 6.401, "w": "العزم"}, {"t0": 6.401, "t1": 6.822, "w": "في"}, {"t0": 6.822, "t1": 7.242, "w": "نفس"}, {"t0": 7.242, "t1": 7.662, "w": "الرقم"}, {"t0": 7.662, "t1": 8.082, "w": "لأن"}, {"t0": 8.082, "t1": 8.502, "w": "الطاقة"}, {"t0": 8.502, "t1": 8.922, "w": "مبتضيعش."}], "text": "وكل ما السرعة تقل القوة تزيد بنفس النسبة، قسمت السرعة على تلاتة يبقى ضربت العزم في نفس الرقم لأن الطاقة مبتضيعش."}, {"n": 5, "dur": 10.864, "lead": 0.4, "audio": "audio/line05.mp3", "offset": 41.984, "words": [{"t0": 0.1, "t1": 0.566, "w": "موتور"}, {"t0": 0.566, "t1": 1.033, "w": "واحد"}, {"t0": 1.033, "t1": 1.499, "w": "ونص"}, {"t0": 1.499, "t1": 1.966, "w": "كيلووات"}, {"t0": 1.966, "t1": 2.432, "w": "بيطلع"}, {"t0": 2.432, "t1": 2.899, "w": "عشرة"}, {"t0": 2.899, "t1": 3.365, "w": "نيوتن"}, {"t0": 3.365, "t1": 3.831, "w": "متر"}, {"t0": 3.831, "t1": 4.298, "w": "بس،"}, {"t0": 4.298, "t1": 4.764, "w": "وبعد"}, {"t0": 4.764, "t1": 5.231, "w": "جيربوكس"}, {"t0": 5.231, "t1": 5.697, "w": "بتخفيض"}, {"t0": 5.697, "t1": 6.164, "w": "تلاتين"}, {"t0": 6.164, "t1": 6.63, "w": "مرة"}, {"t0": 6.63, "t1": 7.096, "w": "بيطلع"}, {"t0": 7.096, "t1": 7.563, "w": "تقريباً"}, {"t0": 7.563, "t1": 8.029, "w": "تلاتمية"}, {"t0": 8.029, "t1": 8.496, "w": "نيوتن"}, {"t0": 8.496, "t1": 8.962, "w": "متر"}, {"t0": 8.962, "t1": 9.429, "w": "على"}, {"t0": 9.429, "t1": 9.895, "w": "السير."}], "text": "موتور واحد ونص كيلووات بيطلع عشرة نيوتن متر بس، وبعد جيربوكس بتخفيض تلاتين مرة بيطلع تقريباً تلاتمية نيوتن متر على السير."}, {"n": 6, "dur": 10.216, "lead": 0.4, "audio": "audio/line06.mp3", "offset": 52.848, "words": [{"t0": 0.1, "t1": 0.536, "w": "أسنان"}, {"t0": 0.536, "t1": 0.971, "w": "الأتراس"}, {"t0": 0.971, "t1": 1.407, "w": "مش"}, {"t0": 1.407, "t1": 1.842, "w": "مستقيمة،"}, {"t0": 1.842, "t1": 2.278, "w": "دي"}, {"t0": 2.278, "t1": 2.713, "w": "مايلة"}, {"t0": 2.713, "t1": 3.149, "w": "شوية"}, {"t0": 3.149, "t1": 3.584, "w": "واسمها"}, {"t0": 3.584, "t1": 4.02, "w": "حلزونية،"}, {"t0": 4.02, "t1": 4.455, "w": "كذا"}, {"t0": 4.455, "t1": 4.891, "w": "سنة"}, {"t0": 4.891, "t1": 5.326, "w": "بتش