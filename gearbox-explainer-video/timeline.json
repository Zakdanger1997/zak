, {"t0": 3.474, "t1": 3.896, "w": "الصغير"}, {"t0": 3.896, "t1": 4.318, "w": "مع"}, {"t0": 4.318, "t1": 4.739, "w": "جيربوكس"}, {"t0": 4.739, "t1": 5.161, "w": "بيديك"}, {"t0": 5.161, "t1": 5.583, "w": "نفس"}, {"t0": 5.583, "t1": 6.005, "w": "العزم"}, {"t0": 6.005, "t1": 6.426, "w": "بتمن"}, {"t0": 6.426, "t1": 6.848, "w": "أرخص"}, {"t0": 6.848, "t1": 7.27, "w": "وكهرباء"}, {"t0": 7.27, "t1": 7.692, "w": "أقل"}, {"t0": 7.692, "t1": 8.113, "w": "بكتير"}, {"t0": 8.113, "t1": 8.535, "w": "في"}, {"t0": 8.535, "t1": 8.957, "w": "الآخر."}], "text": "ناس كتير فاكرة إن الحل موتور أكبر، لأ، الصغير مع جيربوكس بيديك نفس العزم بتمن أرخص وكهرباء أقل بكتير في الآخر."}, {"n": 9, "dur": 10.672, "lead": 0.4, "audio": "audio/line09.mp3", "offset": 83.256, "words": [{"t0": 0.1, "t1": 0.58, "w": "ببساطة"}, {"t0": 0.58, "t1": 1.06, "w": "الجيربوكس"}, {"t0": 1.06, "t1": 1.54, "w": "بياخد"}, {"t0": 1.54, "t1": 2.021, "w": "لفات"}, {"t0": 2.021, "t1": 2.501, "w": "كتير"}, {"t0": 2.501, "t1": 2.981, "w": "بقوة"}, {"t0": 2.981, "t1": 3.461, "w": "صغيرة"}, {"t0": 3.461, "t1": 3.941, "w": "ويطلعلك"}, {"t0": 3.941, "t1": 4.421, "w": "دورات"}, {"t0": 4.421, "t1": 4.901, "w": "قليلة"}, {"t0": 4.901, "t1": 5.382, "w": "بعزم"}, {"t0": 5.382, "t1": 5.862, "w": "جبار،"}, {"t0": 5.862, "t1": 6.342, "w": "وكده"}, {"t0": 6.342, "t1": 6.822, "w": "موتور"}, {"t0": 6.822, "t1": 7.302, "w": "قد"}, {"t0": 7.302, "t1": 7.782, "w": "الإيد"}, {"t0": 7.782, "t1": 8.263, "w": "بيحرك"}, {"t0": 8.263, "t1": 8.743, "w": "سير"}, {"t0": 8.743, "t1": 9.223, "w": "بطول"}, {"t0": 9.223, "t1": 9.703, "w": "الأوضة."}], "text": "ببساطة الجيربوكس بياخد لفات كتير بقوة صغيرة ويطلعلك دورات قليلة بعزم جبار، وكده موتور قد الإيد بيحرك سير بطول الأوضة."}], "total": 93.528, "fps": 30}