    {
      "parameters": {
        "jsCode": "// Daha önce mail atılan firmaları ve liste içi tekrarları eler\nconst FREE = ['gmail.com','hotmail.com','outlook.com','yahoo.com','icloud.com','yandex.com','mail.ru','protonmail.com','live.com','msn.com'];\nconst esc = s => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\n\nconst adaylar = $('Mailleri Ayıkla').all().map(i => i.json);\nconst gonderilen = $input.all().map(i => i.json).filter(r => r && (r.email || r.domain));\n\nif (adaylar.length && adaylar[0].no_emails) {\n  return [{ json: { yeni_yok: true, chat_id: adaylar[0].chat_id, mesaj: 'Mesajınızda e-posta adresi bulamadım. Lütfen başvurmak istediğiniz firmaların e-posta adreslerini gönderin.' } }];\n}\n\nconst chatId = adaylar[0].chat_id;\nconst gEmail = new Set(gonderilen.map(g => String(g.email || '').toLowerCase()).filter(Boolean));\nconst gDomain = new Set(gonderilen.map(g => String(g.domain || '').toLowerCase()).filter(d => d && !FREE.includes(d)));\n\nconst yeni = [];\nconst atlanan = [];\nconst goruldu = new Set();\n\nfor (const a of adaylar) {\n  const kurumsal = !FREE.includes(a.domain);\n  if (gEmail.has(a.email) || (kurumsal && gDomain.has(a.domain))) {\n    atlanan.push(esc(a.email) + ' → bu firmaya daha önce gönderilmiş');\n    continue;\n  }\n  if (kurumsal && goruldu.has(a.domain)) {\n    atlanan.push(esc(a.email) + ' → listede aynı firmadan başka adres var');\n    continue;\n  }\n  if (kurumsal) goruldu.add(a.domain);\n  yeni.push(a);\n}\n\nif (yeni.length === 0) {\n  return [{ json: { yeni_yok: true, chat_id: chatId, mesaj: 'Gönderilecek yeni firma yok.' + (atlanan.length ? '\\n\\nAtlananlar:\\n- ' + atlanan.join('\\n- ') : '') } }];\n}\n\nreturn yeni.map(a => ({ json: a }));"
      },
