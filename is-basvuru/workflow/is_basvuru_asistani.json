          "id": "openai-cred",
          "name": "OpenAI Hesabım"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// AI cevabını JSON olarak çözer ve Telegram onay mesajını hazırlar\nconst esc = s => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\nconst cand = $('Yenileri Süz').item.json;\nconst ayar = $('Ayarlar').first().json;\n\nlet raw = String($json.output ?? $json.text ?? '');\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nlet p = {};\ntry { p = JSON.parse(m ? m[0] : raw); } catch (e) {\n  p = { firma_adi: cand.domain, sektor: '', konu: 'İş Başvurusu - ' + ayar.ad_soyad, mail_metni: raw };\n}\n\nconst id = Math.random().toString(36).slice(2, 8);\nconst tarih = new Date().toISOString().slice(0, 16).replace('T', ' ');\nconst firma = p.firma_adi || cand.domain;\nconst konu = p.konu || ('İş Başvurusu - ' + ayar.ad_soyad);\nconst govde = p.mail_metni || '';\n\nconst onay_mesaji = '🏢 Firma: ' + esc(firma)\n  + '\\n🏷 Sektör: ' + esc(p.sektor || '-')\n  + '\\n📧 Alıcı: ' + esc(cand.email)\n  + '\\n📌 Konu: ' + esc(konu)\n  + '\\n\\n━━━━━━━━━━━━━━\\n'\n  + esc(govde).slice(0, 2500)\n  + '\\n━━━━━━━━━━━━━━\\n\\nBu başvuruyu göndereyim mi?';\n\nreturn { json: { id, tarih, email: cand.email, domain: cand.domain, firma, sektor: p.sektor || '', konu, govde, durum: 'BEKLIYOR', chat_id: cand.chat_id, onay_mesaji } };"
      },
