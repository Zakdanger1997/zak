    {
      "parameters": {
        "jsCode": "// Gönder / atla / mükerrer (aynı firmaya ikinci mail) kararını verir\nconst FREE = ['gmail.com','hotmail.com','outlook.com','yahoo.com','icloud.com','yandex.com','mail.ru','protonmail.com','live.com','msn.com'];\nconst esc = s => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\n\nconst onay = $('Onayı Çöz').first().json;\nconst taslaklar = $('Taslağı Bul').all().map(i => i.json).filter(r => r && r.id);\nconst gonderilen = $input.all().map(i => i.json).filter(r => r && (r.email || r.domain));\n\nconst taslak = taslaklar.find(r => String(r.id) === String(onay.draft_id));\n\nif (!taslak) {\n  return [{ json: { decision: 'uyari', chat_id: onay.chat_id, bildirim: '⚠️ Taslak bulunamadı (id: ' + esc(onay.draft_id) + '). Google Sheet içindeki Taslaklar sayfasını kontrol edin.' } }];\n}\nif (String(taslak.durum) === 'GONDERILDI') {\n  return [{ json: { decision: 'uyari', chat_id: onay.chat_id, bildirim: '⚠️ Bu başvuru zaten gönderilmiş: ' + esc(taslak.firma) } }];\n}\nif (onay.action !== 'send') {\n  return [{ json: { ...taslak, ...onay, decision: 'atla', bildirim: '⏭ Atlandı: ' + esc(taslak.firma) + ' (' + esc(taslak.email) + ')' } }];\n}\n\nconst d = String(taslak.domain || '').toLowerCase();\nconst kurumsal = d && !FREE.includes(d);\nconst mukerrer = gonderilen.some(g =>\n  String(g.email || '').toLowerCase() === String(taslak.email || '').toLowerCase()\n  || (kurumsal && String(g.domain || '').toLowerCase() === d)\n);\nif (mukerrer) {\n  return [{ json: { decision: 'uyari', chat_id: onay.chat_id, bildirim: '⚠️ ' + esc(taslak.firma) + ' firmasına zaten mail gönderilmiş. Aynı firmaya ikinci kez göndermedim.' } }];\n}\n\nreturn [{ json: { ...taslak, ...onay, decision: 'gonder', bildirim: '✅ Gönderildi: ' + esc(taslak.firma) + ' (' + esc(taslak.email) + ')\\n📄 CV eklendi ve firma gönderilenler listesine kaydedildi.' } }];"
      },
